---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const siteUrl = Astro.site
  ? Astro.site.toString().replace(/\/$/, "")
  : "https://ytumint.org";

const communities = [
  {
    name: "YTÜ Deptron",
    alternateName: "Deptron Robotics",
    description:
      "Deptron Robotics, depo lojistiğinde devrim yaratmak için yola çıkmış bir teknoloji girişimidir. Depo ve üretim tesislerinde sesli asistan destekli yapay zeka teknolojileri geliştiriyoruz. Hedefimiz iş güvenliğini artıran, operasyonel hataları minimize eden ve karbon ayak izini azaltan sürdürülebilir çözümler geliştirmek.",
    logo: "/communities/deptron-logo.webp",
    logoAlt: "YTÜ Deptron Robotik Topluluğu Logosu - YTÜ MİNT",
    links: [
      {
        name: "Instagram",
        url: "https://www.instagram.com/deptron_robotics/",
        type: "instagram",
      },
      {
        name: "Web Sitesi",
        url: "https://deptronrobotics.com/",
        type: "website",
      },
    ],
  },
  {
    name: "Huawei Student Developers (HSD YTU)",
    alternateName: "HSD YTÜ",
    description:
      "Huawei Student Developers (HSD), teknoloji ve yazılım tutkusunu paylaşan üniversite öğrencilerine; eğitimler, etkinlikler ile birlikte öğrenme ortamı sağlayarak bilgi ve deneyimlerini geliştirme fırsatı sunan küresel bir programdır. HSD, teknoloji, yazılım, liderlik, kariyer gibi konularda ekosistemindeki üyelere eğitimler verir ve etkinlikler düzenler ve bunlarla ilgili proje geliştirme imkanı sunar.",
    logo: "/communities/hsd-logo.webp",
    logoAlt: "Huawei Student Developers (HSD YTU) Topluluk Logosu - YTÜ MİNT",
    links: [
      {
        name: "Instagram",
        url: "https://www.instagram.com/hsd.ytu/",
        type: "instagram",
      },
      {
        name: "Web Sitesi",
        url: "https://medium.com/@hsdytu",
        type: "website",
      },
    ],
  },
  {
    name: "YTÜ Blockchain",
    alternateName: "Yıldız Blockchain",
    description:
      "Yıldız Teknik Üniversitesi Blockchain; blockchain, DeFi, zero-knowledge ve açık kaynak teknolojileri üzerine öğrenen, üreten ve paylaşan bir öğrenci topluluğudur. Blockchain teknolojisini kampüste erişilebilir kılmak; öğrencilerin teoriyi pratiğe döktüğü, birlikte öğrenip ürettiği bir alan açmak istiyoruz. Amacımız fikir ile uygulama arasındaki mesafeyi kısaltmak. Atölyeler, açık kaynak projeler ve teknik içeriklerle üyelerimizin haftalar değil günler içinde gerçek işler ortaya koymasını sağlıyoruz.",
    logo: "/communities/bc-logo.webp",
    logoAlt: "YTÜ Blockchain Topluluğu Logosu - YTÜ MİNT",
    links: [
      {
        name: "Instagram",
        url: "https://www.instagram.com/ytu_blockchain/",
        type: "instagram",
      },
      {
        name: "Web Sitesi",
        url: "https://ytublockchain.com/tr",
        type: "website",
      },
    ],
  },
  {
    name: "Yıldız Siber",
    alternateName: "YTÜ Siber Güvenlik Topluluğu",
    description:
      "Siber güvenlik, sızma testleri (pentest), CTF yarışmaları, web uygulama güvenliği ve zararlı yazılım analizi alanlarında teorik ve uygulamalı eğitimler düzenliyoruz.",
    logo: "/communities/yildiz-siber.webp",
    logoAlt: "Yıldız Siber Güvenlik Topluluğu Logosu - YTÜ MİNT",
    links: [
      {
        name: "Instagram",
        url: "https://www.instagram.com/yildizsiber/",
        type: "instagram",
      },
    ],
  },
];

const communitiesJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "YTÜ MİNT Alt Toplulukları",
  description:
    "YTÜ MİNT çatısı altında robotik, yapay zeka, blockchain ve siber güvenlik alanlarındaki topluluklarımızı inceleyin ve projelere katılın.",
  itemListElement: communities.map((comm, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Organization",
      name: comm.name,
      alternateName: comm.alternateName,
      description: comm.description,
      logo: `${siteUrl}${comm.logo}`,
      image: `${siteUrl}${comm.logo}`,
      url:
        comm.links.find((l) => l.type === "website")?.url ||
        comm.links[0]?.url ||
        siteUrl,
      sameAs: comm.links.map((l) => l.url),
      parentOrganization: {
        "@type": "Organization",
        name: "YTÜ MİNT",
        url: `${siteUrl}/`,
      },
    },
  })),
};
---

<Layout
  title="Topluluklarımız | YTÜ MİNT"
  description="YTÜ MİNT bünyesindeki YTÜ Deptron, HSD YTU, YTÜ Blockchain ve Yıldız Siber topluluklarını keşfedin; robotik, yapay zeka ve Web3 projelerine hemen dahil olun."
  keywords="YTÜ toplulukları, YTÜ Deptron, Deptron Robotics, Huawei Student Developers, HSD YTU, YTÜ Blockchain, Yıldız Siber, siber güvenlik kulübü, yapay zeka kulübü, Web3, öğrenci toplulukları, YTÜ MİNT"
  jsonLd={communitiesJsonLd}
>
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <div>
          <h1 class="page-hero-title">Topluluklarımız</h1>
          <Breadcrumb currentPage="Topluluklarımız" />
        </div>
      </div>
    </div>
  </section>

  <!-- Communities Grid -->
  <section class="communities-section">
    <div class="container">
      <div class="communities-grid">
        {
          communities.map((community) => (
            <div class="community-card">
              <div class="community-card-header">
                <div class="community-card-logo-box">
                  <img
                    src={community.logo}
                    alt={community.logoAlt}
                    class="community-card-logo"
                    width="68"
                    height="68"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div>
                  <h2 class="community-name">{community.name}</h2>
                </div>
              </div>

              <p class="community-card-desc">{community.description}</p>

              <div class="community-card-footer">
                <div class="community-links">
                  {community.links.map((link) => (
                    <a
                      href={link.url}
                      class="community-social-btn"
                      aria-label={`${community.name} ${link.name}`}
                      title={link.name}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.type === "instagram" ? (
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                        >
                          <rect
                            x="2"
                            y="2"
                            width="20"
                            height="20"
                            rx="5"
                            ry="5"
                            stroke="currentColor"
                            stroke-width="2"
                          />
                          <circle
                            cx="12"
                            cy="12"
                            r="4"
                            stroke="currentColor"
                            stroke-width="2"
                          />
                          <circle
                            cx="17.5"
                            cy="6.5"
                            r="1.5"
                            fill="currentColor"
                          />
                        </svg>
                      ) : (
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <circle cx="12" cy="12" r="10" />
                          <line x1="2" y1="12" x2="22" y2="12" />
                          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                        </svg>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Minimalist Join CTA -->
  <section class="join-cta-section">
    <div class="container">
      <div class="join-cta-card">
        <div class="join-cta-content">
          <h2 class="join-cta-title">Ekibimizin Bir Parçası Olun</h2>
          <p class="join-cta-desc">
            Projelerimizde yer almak, teknik ekiplerimize katılmak veya alt
            topluluklarımızda aktif rol almak için bizimle iletişime
            geçebilirsiniz.
          </p>
        </div>
        <div class="join-cta-action">
          <a
            href="/contact"
            class="btn btn-green join-cta-btn"
            aria-label="Bizimle iletişime geçin"
          >
            <span>İletişime Geç</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Page Hero */
  .page-hero {
    min-height: 160px;
    display: flex;
    align-items: center;
    padding: 48px 0;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  .page-hero .container {
    width: 100%;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/brand/mint-pattern.webp");
    background-size: 260px 260px;
    background-repeat: repeat;
    background-position: center;
    opacity: 0.035;
    pointer-events: none;
    z-index: 0;
  }

  .page-hero-inner {
    max-width: 680px;
    position: relative;
    z-index: 2;
  }

  .page-hero-title {
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 700;
    margin: 0;
    color: var(--dark);
    letter-spacing: -0.02em;
  }

  /* Communities */
  .communities-section {
    padding: 48px 0 32px;
    background: var(--bg-main);
    position: relative;
    overflow: hidden;
  }

  .communities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 1060px;
    margin: 0 auto;
  }

  .community-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px 20px 14px;
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 10px;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
    position: relative;
  }

  :global([data-theme="dark"]) .community-card {
    background: var(--bg-card);
  }

  .community-card:hover {
    transform: translateY(-2px);
    border-color: rgba(97, 169, 93, 0.35);
    box-shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.04);
  }

  :global([data-theme="dark"]) .community-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.4);
  }

  .community-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .community-card-logo-box {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .community-card:hover .community-card-logo-box {
    transform: scale(1.04);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
  }

  .community-card-logo {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  .community-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--dark);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .community-card-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-muted);
    flex: 1;
    margin: 0;
  }

  .community-card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--border-subtle);
  }

  :global([data-theme="dark"]) .community-card-footer {
    border-top-color: rgba(255, 255, 255, 0.05);
  }

  .community-links {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .community-social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    text-decoration: none;
    background: var(--bg-muted);
    color: var(--text-muted);
    border: 1px solid var(--border);
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .community-social-btn:hover {
    background: var(--dark);
    color: var(--white);
    border-color: var(--dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.12);
  }

  :global([data-theme="dark"]) .community-social-btn:hover {
    background: var(--white);
    color: #0f172a;
    border-color: var(--white);
    box-shadow: 0 4px 10px rgba(255, 255, 255, 0.15);
  }

  /* ── Minimalist Join CTA ──────────────────────────────────── */
  .join-cta-section {
    padding: 16px 0 64px;
    background: var(--bg-main);
  }

  .join-cta-card {
    max-width: 1060px;
    margin: 0 auto;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 32px 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
    position: relative;
    overflow: hidden;
  }

  :global([data-theme="dark"]) .join-cta-card {
    background: var(--bg-card);
  }

  .join-cta-content {
    flex: 1;
    max-width: 680px;
  }

  .join-cta-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--dark);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .join-cta-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  .join-cta-action {
    flex-shrink: 0;
  }

  .join-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    font-size: 13.5px;
    font-weight: 600;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .join-cta-btn svg {
    transition: transform 0.2s ease;
  }

  .join-cta-btn:hover svg {
    transform: translateX(3px);
  }

  /* ── Responsive ─────────────────────────────────────────────── */

  /* Tablet: 960px ve altı — tek kolon */
  @media (max-width: 960px) {
    .communities-grid {
      grid-template-columns: 1fr;
    }

    .join-cta-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 28px 24px;
      gap: 20px;
    }

    .join-cta-action {
      width: 100%;
    }

    .join-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }

  /* Küçük tablet: 768px ve altı */
  @media (max-width: 768px) {
    .page-hero {
      min-height: 120px;
      padding: 32px 0;
    }

    .page-hero-title {
      font-size: 26px;
    }

    .communities-section {
      padding: 36px 0 24px;
    }

    .communities-grid {
      gap: 16px;
    }

    .community-card {
      padding: 14px 18px 12px;
      gap: 9px;
    }

    .community-name {
      font-size: 15px;
    }

    .community-card-desc {
      font-size: 12.5px;
    }

    .join-cta-section {
      padding: 12px 0 48px;
    }

    .join-cta-title {
      font-size: 18px;
    }

    .join-cta-desc {
      font-size: 13.5px;
    }
  }

  /* Mobil: 640px ve altı */
  @media (max-width: 640px) {
    .page-hero {
      min-height: 100px;
      padding: 24px 0;
    }

    .page-hero-title {
      font-size: 22px;
    }

    .communities-section {
      padding: 28px 0 20px;
    }

    .communities-grid {
      gap: 12px;
    }

    .community-card {
      padding: 14px 14px 12px;
      gap: 8px;
    }

    .community-card-header {
      gap: 10px;
    }

    .community-card-logo-box {
      width: 44px;
      height: 44px;
      border-radius: 10px;
    }

    .community-name {
      font-size: 14px;
    }

    .community-card-desc {
      font-size: 12px;
      line-height: 1.5;
    }

    .join-cta-section {
      padding: 10px 0 40px;
    }

    .join-cta-card {
      padding: 22px 18px;
      gap: 16px;
    }

    .join-cta-title {
      font-size: 17px;
    }

    .join-cta-desc {
      font-size: 13px;
    }
  }

  /* Ekstra küçük mobil: 480px ve altı */
  @media (max-width: 480px) {
    .page-hero-title {
      font-size: 20px;
    }

    .community-card {
      padding: 12px 12px 10px;
      gap: 7px;
    }

    .community-card-logo-box {
      width: 40px;
      height: 40px;
      border-radius: 9px;
    }

    .community-name {
      font-size: 13.5px;
    }

    .community-card-desc {
      font-size: 11.5px;
    }

    .community-card-footer {
      padding-top: 8px;
    }

    .join-cta-card {
      padding: 18px 14px;
      gap: 14px;
    }

    .join-cta-title {
      font-size: 16px;
    }

    .join-cta-desc {
      font-size: 12.5px;
    }

    .join-cta-btn {
      padding: 10px 16px;
      font-size: 13px;
    }
  }
</style>
